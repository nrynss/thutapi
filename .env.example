# Copy to .env and fill in. .env is gitignored.

# Origin IP of the deployment host, behind the Cloudflare proxy.
# Never commit the real value — see deploy/README.md §DNS.
ORIGIN_IP=<origin-ip>

# GMI Cloud inference key. Passed to the container by deploy/docker-run.sh.
GMI_API_KEY=<gmi-api-key>

# Public HTTPS host GMI uses to fetch a short-lived voice sample. Not secret.
PUBLIC_ORIGIN=https://thutapi.nryn.dev

# Bearer for the voice-sample upload route (POST /voice-sample). The process
# REFUSES TO START without one. deploy/docker-run.sh generates a random token
# per run and writes it to ${DATA_DIR}/upload-token; set it here only when you
# want a fixed value. Secret: give it to the consenting adult through a secure
# channel, never in a URL or the browser bundle.
UPLOAD_TOKEN=<upload-token>

# T11 gate. OPTIONAL and unset by default: the money routes always carry a
# per-client and a process-wide rate limit, and setting this adds a shared
# passcode on top of them (X-Thutapi-Passcode header or thutapi_gate cookie).
# Leave it empty for judging — a demo nobody can start scores the same as one
# that was never deployed — and set it if the public URL is found and abused.
# Secret when set; see internal/gate's package doc for the full reasoning.
# GATE_PASSCODE=<passcode>

# T11 retention. Byte budget for generated media under ${DATA_DIR}/media.
# Unset uses the package default (6 GiB, against 23 GiB free on the box);
# 0 means no byte budget at all, orphan sweeping only. The orphan sweep —
# unplaced interview-question clips and crash-left files — always runs.
# MEDIA_MAX_BYTES=6442450944

# T11 prewarm. Directory of finished-book fixtures restored at boot and
# protected from the retention budget. Unset means ${DATA_DIR}/prewarm, which
# on the box is /srv/thutapi/data/prewarm — copy a fixture directory there and
# the book is back after a redeploy with no model calls. Write one with:
#   thutapi -data-dir <dir> -prewarm-export <book id>
# PREWARM_DIR=/data/prewarm
