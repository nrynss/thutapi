# Copy to .env and fill in. .env is gitignored.

# Origin IP of the deployment host, behind the Cloudflare proxy.
# Never commit the real value — see deploy/README.md §DNS.
ORIGIN_IP=<origin-ip>

# GMI Cloud inference key. Passed to the container by deploy/docker-run.sh.
GMI_API_KEY=<gmi-api-key>

# Public HTTPS host GMI uses to fetch a short-lived voice sample. Not secret.
PUBLIC_ORIGIN=https://thutapi.nryn.dev
